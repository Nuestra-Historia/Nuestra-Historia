# Paths de administración secretos (mínimo 24 caracteres, caracteres [A-Za-z0-9_-], distintos entre sí)
OWNER_ADMIN_PATH=
SHARED_ADMIN_PATH=

# Hashes bcrypt (costo 12) de las contraseñas, codificados en Base64
# Generados con: npm run gen:hash
OWNER_PASSWORD_HASH_B64=
SHARED_PASSWORD_HASH_B64=

# Secreto de sesión JWT (mínimo 32 caracteres)
SESSION_SECRET=

# Secreto para el endpoint de cron keepalive
CRON_SECRET=

# Pepper secreto para el hash de IPs (prevención de fuerza bruta)
IP_HASH_PEPPER=

# Origen esperado para las solicitudes (ej: http://localhost:3000 o https://tudominio.com)
SITE_ORIGIN=http://localhost:3000

# Conexión a Supabase (solo servidor, service role key)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

